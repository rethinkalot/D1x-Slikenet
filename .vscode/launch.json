{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "D1x-Redux-SLikeNet.exe",
            "type": "cppdbg",
            "request": "launch",
            "program": "C:/Games/D1x/D1x-Redux-SLikeNet.exe",
            "args": [
                "-nostickykeys",
                "-verbose",
                "-window"
