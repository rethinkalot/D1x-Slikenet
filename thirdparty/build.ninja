# Utility command for edit_cache

build thirdparty/sdl2/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D C:\my\project\build\thirdparty\sdl2 && C:\Programs\msys64\mingw32\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build thirdparty/sdl2/edit_cache: phony thirdparty/sdl2/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build thirdparty/sdl2/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D C:\my\project\build\thirdparty\sdl2 && C:\Programs\msys64\mingw32\bin\cmake.exe --regenerate-during-build -SC:\my\project -BC:\my\project\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build thirdparty/sdl2/rebuild_cache: phony thirdparty/sdl2/CMakeFiles/rebuild_cache.util


