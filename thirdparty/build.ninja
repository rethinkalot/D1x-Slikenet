# =============================================================================
# Object build statements for SHARED_LIBRARY target SDL


#############################################
# Order-only phony target for SDL

build cmake_object_order_depends_target_SDL: phony || .

build thirdparty/sdl12-compat/CMakeFiles/SDL.dir/src/SDL12_compat.c.obj: C_COMPILER__SDL_unscanned_ C$:/my/project/thirdparty/sdl12-compat/src/SDL12_compat.c || cmake_object_order_depends_target_SDL
  DEFINES = -DDLL_EXPORT -DSDL_EXPORTS
  DEP_FILE = thirdparty\sdl12-compat\CMakeFiles\SDL.dir\src\SDL12_compat.c.obj.d
  FLAGS = -Wno-address-of-packed-member -Wno-deprecated-declarations -Wno-format-truncation -Wno-format-overflow  -Wall -Wdeclaration-after-statement -Werror=declaration-after-statement
  INCLUDES = -IC:/my/project/thirdparty/sdl2/include -IC:/my/project/build/thirdparty/sdl2/include -IC:/my/project/build/thirdparty/sdl2/include-config-/SDL2
  OBJECT_DIR = thirdparty\sdl12-compat\CMakeFiles\SDL.dir
  OBJECT_FILE_DIR = thirdparty\sdl12-compat\CMakeFiles\SDL.dir\src
  TARGET_COMPILE_PDB = thirdparty\sdl12-compat\CMakeFiles\SDL.dir\
  TARGET_PDB = thirdparty\sdl12-compat\SDL.pdb
  TARGET_SUPPORT_DIR = thirdparty\sdl12-compat\CMakeFiles\SDL.dir

build thirdparty/sdl12-compat/CMakeFiles/SDL.dir/src/version.rc.obj: RC_COMPILER__SDL_unscanned_ C$:/my/project/thirdparty/sdl12-compat/src/version.rc || cmake_object_order_depends_target_SDL
  DEFINES = -DDLL_EXPORT -DSDL_EXPORTS
  DEP_FILE = thirdparty\sdl12-compat\CMakeFiles\SDL.dir\src\version.rc.obj.d
  INCLUDES = -I C:/my/project/thirdparty/sdl2/include -I C:/my/project/build/thirdparty/sdl2/include -I C:/my/project/build/thirdparty/sdl2/include-config-/SDL2
  OBJECT_DIR = thirdparty\sdl12-compat\CMakeFiles\SDL.dir
  OBJECT_FILE_DIR = thirdparty\sdl12-compat\CMakeFiles\SDL.dir\src
  TARGET_COMPILE_PDB = thirdparty\sdl12-compat\CMakeFiles\SDL.dir\
  TARGET_PDB = thirdparty\sdl12-compat\SDL.pdb
  TARGET_SUPPORT_DIR = thirdparty\sdl12-compat\CMakeFiles\SDL.dir


# =============================================================================
# Link build statements for SHARED_LIBRARY target SDL


#############################################
# Link the shared library thirdparty\sdl12-compat\SDL.dll

build thirdparty/sdl12-compat/SDL.dll thirdparty/sdl12-compat/libSDL.dll.a: C_SHARED_LIBRARY_LINKER__SDL_ thirdparty/sdl12-compat/CMakeFiles/SDL.dir/src/SDL12_compat.c.obj thirdparty/sdl12-compat/CMakeFiles/SDL.dir/src/version.rc.obj
  LANGUAGE_COMPILE_FLAGS = -Wno-address-of-packed-member -Wno-deprecated-declarations -Wno-format-truncation -Wno-format-overflow  -Wall -Wdeclaration-after-statement -Werror=declaration-after-statement
  LINK_FLAGS = -shared -nostdlib
  LINK_LIBRARIES = -static-libgcc -lgcc  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32
  OBJECT_DIR = thirdparty\sdl12-compat\CMakeFiles\SDL.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  RESTAT = 1
  TARGET_COMPILE_PDB = thirdparty\sdl12-compat\CMakeFiles\SDL.dir\
  TARGET_FILE = thirdparty\sdl12-compat\SDL.dll
  TARGET_IMPLIB = thirdparty\sdl12-compat\libSDL.dll.a
  TARGET_PDB = thirdparty\sdl12-compat\SDL.pdb
